---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {% assign public_pages = site.pages | where_exp: "item", "item.sitemap != false" %}
  {% for item in public_pages %}
    {% unless item.url contains '/assets/' or item.url contains '/404' or item.url == '/research/' or item.url == '/about/' %}
      <url><loc>{{ item.url | absolute_url }}</loc></url>
    {% endunless %}
  {% endfor %}
</urlset>

