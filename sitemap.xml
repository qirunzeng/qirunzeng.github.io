---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {% assign public_pages = site.pages | where_exp: "item", "item.sitemap != false" %}
  {% for item in public_pages %}
    {% if item.layout == 'default' and item.url != '/404.html' %}
      <url><loc>{{ item.url | absolute_url }}</loc></url>
    {% endif %}
  {% endfor %}
</urlset>

